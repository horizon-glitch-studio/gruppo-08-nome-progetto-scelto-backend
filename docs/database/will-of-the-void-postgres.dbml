// Will of the Void – schema del database (PostgreSQL 15+)
// Da incollare su https://dbdiagram.io
// Date come timestamptz (salvate in UTC), encoding UTF8.

Project will_of_the_void {
  database_type: 'PostgreSQL'
  Note: 'Gioco di carte collezionabili digitale – Laboratorio Integrato'
}

// =====================================================================
// ENUM
// =====================================================================

Enum ruolo_utente {
  UTENTE
  ADMIN
}

Enum causale_movimento {
  BONUS_REGISTRAZIONE
  BONUS_GIORNALIERO
  BONUS_INVITO
  ACQUISTO_PACCHETTO
  ISCRIZIONE_TORNEO
  PREMIO_TORNEO
  REFRESH_AVVERSARI
}

Enum tipo_notifica {
  ATTACCO_SUBITO
  SCAMBIO_RICEVUTO
  SCAMBIO_ACCETTATO
  SCAMBIO_RIFIUTATO
  SCAMBIO_SCADUTO
  ERRANTE_PARTITO
  MAZZO_NON_VALIDO
  BONUS_INVITO
}

Enum stato_mazzo {
  INCOMPLETO
  VALIDO
  NON_VALIDO
}

Enum tipo_vantaggio {
  ATTACCO [note: '+valore all\'Attacco di chi prevale']
  DIFESA  [note: '-valore all\'Attacco di chi è sopraffatto (minimo 1)']
}

Enum stato_scambio {
  IN_ATTESA
  ACCETTATO
  RIFIUTATO
  ANNULLATO
  SCADUTO
  FALLITO
}

Enum lato_scambio {
  OFFERTA   [note: 'dal proponente al destinatario']
  RICHIESTA [note: 'dal destinatario al proponente']
}

Enum modalita_partita {
  AMICO
  VELOCE
  COMPETITIVA
  TORNEO
}

Enum modalita_lista {
  VELOCE
  COMPETITIVA
  TORNEO
}

Enum stato_partita {
  IN_ATTESA
  RIFIUTATA
  SCADUTA
  ANNULLATA
  GIOCATA
}

Enum esito_partita {
  VITTORIA_SFIDANTE
  VITTORIA_SFIDATO
  PAREGGIO
}

Enum stato_torneo {
  IN_CORSO
  COMPLETATO
  ELIMINATO
}

Enum stato_amicizia {
  IN_ATTESA
  ACCETTATA
  RIFIUTATA
}

// =====================================================================
// 1 · UTENTE, CREDITI E NOTIFICHE
// =====================================================================

Table utente {
  id                  bigint        [pk, increment]
  username            varchar(50)   [not null, unique]
  email               varchar(255)  [not null, unique]
  password_hash       varchar(255)  [not null]
  ruolo               ruolo_utente  [not null, default: 'UTENTE']
  email_verificata_at timestamptz
  mazzo_difesa_id     bigint        [unique, note: 'deve appartenere allo stesso utente (controllo nel service)']
  saldo_crediti       int           [not null, default: 0, note: 'CHECK >= 0']
  coppe               int           [not null, default: 0, note: 'CHECK >= 0']
  energia_totale      bigint        [not null, default: 0]
  ultimo_bonus_at     timestamptz      [note: 'bonus di accesso giornaliero']
  protetto_fino_at    timestamptz      [note: 'protezione dopo N attacchi subiti']
  codice_invito       varchar(20)   [not null, unique]
  invitato_da_id      bigint
  version             int           [not null, default: 0, note: 'optimistic locking JPA']
  created_at          timestamptz      [not null, default: `now()`]
  eliminato_at        timestamptz      [note: 'soft delete: alla cancellazione username ed email vengono anonimizzati']

  indexes {
    coppe
    eliminato_at
  }
}

Table movimento_crediti {
  id                    bigint            [pk, increment]
  utente_id             bigint            [not null]
  importo               int               [not null, note: 'positivo = entrata, negativo = uscita']
  causale               causale_movimento [not null]
  apertura_pacchetto_id bigint            [unique]
  torneo_id             bigint
  utente_invitato_id    bigint            [unique, note: 'un solo bonus invito per ogni invitato']
  created_at            timestamptz          [not null, default: `now()`]

  indexes {
    (utente_id, created_at)
  }
}

Table notifica {
  id         bigint        [pk, increment]
  utente_id  bigint        [not null]
  tipo       tipo_notifica [not null]
  partita_id bigint
  scambio_id bigint
  carta_id   bigint        [note: 'Errante partito']
  letta      boolean       [not null, default: false]
  created_at timestamptz      [not null, default: `now()`]

  indexes {
    (utente_id, letta)
  }
}

// =====================================================================
// 2 · COLLEZIONE E MAZZI
// =====================================================================

Table collezione {
  utente_id bigint [not null]
  carta_id  bigint [not null]
  quantita  int    [not null, note: 'CHECK > 0']
  scade_at  timestamptz [note: 'solo per gli Erranti: 7 giorni dal ritrovamento']

  indexes {
    (utente_id, carta_id) [pk]
    scade_at
  }
}

Table archivio_ricordi {
  id          bigint   [pk, increment]
  utente_id   bigint   [not null]
  carta_id    bigint   [not null]
  arrivato_at timestamptz [not null]
  partito_at  timestamptz [not null]

  Note: 'Erranti ripartiti: visibili ma non giocabili'
}

Table mazzo {
  id         bigint      [pk, increment]
  utente_id  bigint      [not null]
  nome       varchar(100) [not null]
  stato      stato_mazzo [not null, default: 'INCOMPLETO']
  created_at timestamptz    [not null, default: `now()`]
  updated_at timestamptz    [not null, default: `now()`]
}

Table mazzo_carta {
  mazzo_id bigint [not null]
  carta_id bigint [not null]
  quantita int    [not null, note: 'CHECK > 0']

  indexes {
    (mazzo_id, carta_id) [pk]
  }
}

// =====================================================================
// 3 · CATALOGO E PACCHETTI
// =====================================================================

Table fazione {
  id     int         [pk, increment]
  nome   varchar(50) [not null, unique]
  inerte boolean     [not null, default: false, note: 'true per i Gas Nobili: nessun vantaggio né svantaggio']
}

Table vantaggio_fazione {
  fazione_prevalente_id  int            [not null]
  fazione_sopraffatta_id int            [not null]
  tipo                   tipo_vantaggio [not null]
  valore                 int            [not null, default: 2]

  indexes {
    (fazione_prevalente_id, fazione_sopraffatta_id) [pk]
  }
  Note: '12 righe; CHECK fazione_prevalente_id <> fazione_sopraffatta_id'
}

Table tier {
  id              int         [pk, increment]
  nome            varchar(50) [not null, unique]
  ordine          int         [not null, unique]
  punti_totali    int         [not null, note: 'Attacco + Difesa richiesti']
  copie_max_mazzo int         [not null]
  max_per_mazzo   int         [note: 'vuoto = nessun limite']
  durata_giorni   int         [note: 'vuoto = permanente; 7 per gli Erranti']
  scambiabile     boolean     [not null, default: true]
}

Table carta {
  id           bigint       [pk, increment]
  nome         varchar(100) [not null, unique]
  descrizione  text
  immagine_url varchar(255)
  fazione_id   int          [not null]
  tier_id      int          [not null]
  attacco      smallint      [not null, note: 'CHECK tra 1 e 10']
  difesa       smallint      [not null, note: 'CHECK tra 1 e 10']
  attiva       boolean      [not null, default: true, note: 'le carte si disattivano, non si cancellano']
  updated_at   timestamptz     [not null, default: `now()`]
}

Table mazzo_iniziale_carta {
  carta_id bigint [pk]
  quantita int    [not null, note: 'CHECK > 0']

  Note: 'Mazzo base uguale per tutti: 30 carte, valido, senza Erranti'
}

Table tipo_pacchetto {
  id            int          [pk, increment]
  nome          varchar(100) [not null]
  costo_crediti int          [not null]
  attivo        boolean      [not null, default: true]
}

Table composizione_pacchetto {
  tipo_pacchetto_id int [not null]
  tier_id           int [not null]
  numero_carte      int [not null, note: 'CHECK > 0']

  indexes {
    (tipo_pacchetto_id, tier_id) [pk]
  }
}

Table apertura_pacchetto {
  id                bigint   [pk, increment]
  utente_id         bigint   [not null]
  tipo_pacchetto_id int      [not null]
  crediti_spesi     int      [not null, note: 'prezzo pagato quel giorno']
  created_at        timestamptz [not null, default: `now()`]
}

Table apertura_carta {
  apertura_id bigint [not null]
  carta_id    bigint [not null]
  quantita    int    [not null, note: 'CHECK > 0']

  indexes {
    (apertura_id, carta_id) [pk]
  }
}

// =====================================================================
// 4 · SCAMBI
// =====================================================================

Table scambio {
  id              bigint        [pk, increment]
  proponente_id   bigint        [not null]
  destinatario_id bigint        [not null]
  stato           stato_scambio [not null, default: 'IN_ATTESA']
  created_at      timestamptz      [not null, default: `now()`]
  scadenza_at     timestamptz      [not null, note: 'proposta: 48 ore']
  concluso_at     timestamptz

  indexes {
    (destinatario_id, stato)
    (proponente_id, stato)
  }
  Note: 'CHECK proponente_id <> destinatario_id'
}

Table scambio_carta {
  scambio_id bigint       [not null]
  carta_id   bigint       [not null]
  lato       lato_scambio [not null]
  quantita   int          [not null, note: 'CHECK > 0']

  indexes {
    (scambio_id, carta_id, lato) [pk]
  }
}

// =====================================================================
// 5 · PARTITE E TORNEO
// =====================================================================

Table partita {
  id                bigint           [pk, increment]
  modalita          modalita_partita [not null]
  stato             stato_partita    [not null]
  sfidante_id       bigint           [not null]
  sfidato_id        bigint           [not null]
  mazzo_sfidante_id bigint           [note: 'vuoto nel torneo (si usa torneo_carta)']
  torneo_id         bigint
  seed              bigint           [note: 'generato lato server']
  esito             esito_partita    [note: 'vuoto finché non è GIOCATA']
  energia_sfidante  int
  energia_sfidato   int
  coppe_sfidante    int              [note: 'variazione, solo COMPETITIVA']
  coppe_sfidato     int              [note: 'variazione, solo COMPETITIVA']
  mazzi_snapshot    jsonb             [note: 'copia dei due mazzi usati']
  log_turni         jsonb             [note: 'risultato turno per turno']
  created_at        timestamptz         [not null, default: `now()`]
  scadenza_at       timestamptz         [note: 'Sfida un amico: 30 secondi']
  giocata_at        timestamptz

  indexes {
    (sfidato_id, giocata_at)
    (sfidante_id, giocata_at)
    torneo_id
  }
  Note: 'CHECK sfidante_id <> sfidato_id'
}

Table torneo {
  id              bigint       [pk, increment]
  utente_id       bigint       [not null]
  stato           stato_torneo [not null, default: 'IN_CORSO']
  vittorie        smallint      [not null, default: 0, note: 'fine a 10']
  sconfitte       smallint      [not null, default: 0, note: 'fine a 3; i pareggi non contano']
  quota_pagata    int          [not null]
  premio_ottenuto int
  created_at      timestamptz     [not null, default: `now()`]
  concluso_at     timestamptz

  indexes {
    (utente_id, stato)
  }
  Note: 'Un solo torneo IN_CORSO per utente: in PostgreSQL con un indice univoco parziale (CREATE UNIQUE INDEX ... ON torneo (utente_id) WHERE stato = \'IN_CORSO\'), da aggiungere a mano'
}

Table torneo_carta {
  torneo_id bigint [not null]
  carta_id  bigint [not null]
  quantita  int    [not null, note: 'CHECK > 0']

  indexes {
    (torneo_id, carta_id) [pk]
  }
  Note: 'Copia bloccata del mazzo salvata all\'iscrizione'
}

// =====================================================================
// 6 · MATCHMAKING
// =====================================================================

Table lista_avversari {
  utente_id          bigint         [not null]
  modalita           modalita_lista [not null]
  generata_at        timestamptz       [not null]
  ultimo_refresh_at  timestamptz
  refresh_usati_oggi int            [not null, default: 0]

  indexes {
    (utente_id, modalita) [pk]
  }
}

Table lista_avversari_voce {
  utente_id        bigint         [not null]
  modalita         modalita_lista [not null]
  posizione        smallint        [not null, note: 'da 1 a 5']
  avversario_id    bigint         [not null]
  coppe_al_momento int            [not null, note: 'solo per la visualizzazione']

  indexes {
    (utente_id, modalita, posizione) [pk]
  }
}

// =====================================================================
// 7 · AMICIZIE
// =====================================================================

Table amicizia {
  id              bigint         [pk, increment]
  richiedente_id  bigint         [not null]
  destinatario_id bigint         [not null]
  stato           stato_amicizia [not null, default: 'IN_ATTESA']
  created_at      timestamptz       [not null, default: `now()`]
  risposta_at     timestamptz

  indexes {
    (`LEAST(richiedente_id, destinatario_id)`, `GREATEST(richiedente_id, destinatario_id)`) [unique, name: 'uq_amicizia_coppia']
    destinatario_id
  }
  Note: 'L\'indice univoco su LEAST/GREATEST impedisce che A-B e B-A coesistano'
}

// =====================================================================
// RELAZIONI
// =====================================================================

// 1 · Utente, crediti e notifiche
Ref: utente.mazzo_difesa_id - mazzo.id [delete: set null]
Ref: utente.invitato_da_id > utente.id [delete: set null]
Ref: movimento_crediti.utente_id > utente.id
Ref: movimento_crediti.apertura_pacchetto_id - apertura_pacchetto.id
Ref: movimento_crediti.torneo_id > torneo.id
Ref: movimento_crediti.utente_invitato_id - utente.id
Ref: notifica.utente_id > utente.id
Ref: notifica.partita_id > partita.id
Ref: notifica.scambio_id > scambio.id
Ref: notifica.carta_id > carta.id

// 2 · Collezione e mazzi
Ref: collezione.utente_id > utente.id
Ref: collezione.carta_id > carta.id
Ref: archivio_ricordi.utente_id > utente.id
Ref: archivio_ricordi.carta_id > carta.id
Ref: mazzo.utente_id > utente.id
Ref: mazzo_carta.mazzo_id > mazzo.id [delete: cascade]
Ref: mazzo_carta.carta_id > carta.id

// 3 · Catalogo e pacchetti
Ref: carta.fazione_id > fazione.id
Ref: carta.tier_id > tier.id
Ref: vantaggio_fazione.fazione_prevalente_id > fazione.id
Ref: vantaggio_fazione.fazione_sopraffatta_id > fazione.id
Ref: mazzo_iniziale_carta.carta_id - carta.id
Ref: composizione_pacchetto.tipo_pacchetto_id > tipo_pacchetto.id
Ref: composizione_pacchetto.tier_id > tier.id
Ref: apertura_pacchetto.utente_id > utente.id
Ref: apertura_pacchetto.tipo_pacchetto_id > tipo_pacchetto.id
Ref: apertura_carta.apertura_id > apertura_pacchetto.id
Ref: apertura_carta.carta_id > carta.id

// 4 · Scambi
Ref: scambio.proponente_id > utente.id
Ref: scambio.destinatario_id > utente.id
Ref: scambio_carta.scambio_id > scambio.id [delete: cascade]
Ref: scambio_carta.carta_id > carta.id

// 5 · Partite e torneo
Ref: partita.sfidante_id > utente.id
Ref: partita.sfidato_id > utente.id
Ref: partita.mazzo_sfidante_id > mazzo.id [delete: set null]
Ref: partita.torneo_id > torneo.id
Ref: torneo.utente_id > utente.id
Ref: torneo_carta.torneo_id > torneo.id [delete: cascade]
Ref: torneo_carta.carta_id > carta.id

// 6 · Matchmaking
Ref: lista_avversari.utente_id > utente.id [delete: cascade]
Ref: lista_avversari_voce.(utente_id, modalita) > lista_avversari.(utente_id, modalita) [delete: cascade]
Ref: lista_avversari_voce.avversario_id > utente.id [delete: cascade]

// 7 · Amicizie
Ref: amicizia.richiedente_id > utente.id
Ref: amicizia.destinatario_id > utente.id

// =====================================================================
// GRUPPI (colorano le aree come nei diagrammi)
// =====================================================================

TableGroup g1_utente_crediti_notifiche {
  utente
  movimento_crediti
  notifica
}

TableGroup g2_collezione_mazzi {
  collezione
  archivio_ricordi
  mazzo
  mazzo_carta
}

TableGroup g3_catalogo_pacchetti {
  fazione
  vantaggio_fazione
  tier
  carta
  mazzo_iniziale_carta
  tipo_pacchetto
  composizione_pacchetto
  apertura_pacchetto
  apertura_carta
}

TableGroup g4_scambi {
  scambio
  scambio_carta
}

TableGroup g5_partite_torneo {
  partita
  torneo
  torneo_carta
}

TableGroup g6_matchmaking {
  lista_avversari
  lista_avversari_voce
}

TableGroup g7_amicizie {
  amicizia
}
